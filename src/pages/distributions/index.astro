---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { layoutDiagram } from '../../../build/site/diagram';
import { getSite } from '../../site';

const site = getSite();
const dists = site.content.distributions;
const diagram = layoutDiagram(
  dists.map((d) => ({ id: d.id, title: d.title, x: d.diagramPosition.x, y: d.diagramPosition.y })),
  dists.flatMap((d) => d.relations.map((r) => ({ from: d.id, to: r.to, label: r.label }))),
);
const groups = [
  { title: '離散分布', items: dists.filter((d) => d.kind === 'discrete') },
  { title: '連続分布', items: dists.filter((d) => d.kind === 'continuous') },
];
---
<BaseLayout title="確率分布" description="主要な確率分布の性質と相互関係">
  <h1>確率分布</h1>
  <p class="muted">準1級で扱う主要な分布の一覧と、分布間の関係図です。分布を選ぶと、性質の一覧とパラメータを操作できるグラフを表示します。</p>

  {dists.length > 0 && (
    <section aria-labelledby="rel">
      <h2 id="rel">分布の関係図</h2>
      <p class="small muted">矢印は「特殊ケース」「極限」「変数変換」などの関係を表します。図は横にスクロールできます。</p>
      <div class="diagram-scroll card">
        <svg class="relation-diagram" viewBox={`0 0 ${diagram.width} ${diagram.height}`} width={diagram.width} height={diagram.height} role="img" aria-label="確率分布の関係図">
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" class="rel-arrow" />
            </marker>
          </defs>
          {diagram.edges.map((e) => (
            <g class="rel-edge">
              <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} marker-end="url(#arrow)"><title>{e.label}</title></line>
            </g>
          ))}
          {diagram.nodes.map((n) => (
            <a href={site.href.dist(n.id)} class="rel-node">
              <rect x={n.cx - n.w / 2} y={n.cy - n.h / 2} width={n.w} height={n.h} rx="8" />
              <text x={n.cx} y={n.cy + 5} text-anchor="middle">{n.title}</text>
            </a>
          ))}
          {/* ラベルはノードに隠れないよう最前面に描く */}
          {diagram.edges.map((e) => (
            <text class="rel-label" x={e.lx} y={Math.abs(e.y2 - e.y1) < 1 ? e.ly - 6 : e.ly + 4} text-anchor="middle">{e.label}</text>
          ))}
        </svg>
      </div>
    </section>
  )}

  {groups.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <ul class="grid dist-list">
        {g.items.map((d) => (
          <li class="card">
            <a class="dist-link" href={site.href.dist(d.id)}>{d.title}</a>
            <div class="small" set:html={site.renderer.renderTex(d.pmfOrPdf, false)} />
            {!d.interactive && <span class="badge">性質の表のみ</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .diagram-scroll { overflow-x: auto; padding: 8px; }
  .relation-diagram { display: block; font-family: var(--font); }
  .rel-edge line { stroke: var(--text-muted); stroke-width: 1.4; }
  .rel-label { fill: var(--text-muted); font-size: 11px; paint-order: stroke; stroke: var(--surface); stroke-width: 4px; stroke-linejoin: round; }
  .rel-arrow { fill: var(--text-muted); }
  .rel-node rect { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.2; }
  .rel-node text { fill: var(--text); font-size: 13px; font-weight: 600; }
  .rel-node:hover rect, .rel-node:focus rect { fill: var(--accent); }
  .rel-node:hover text, .rel-node:focus text { fill: var(--accent-contrast); }
  .dist-list { list-style: none; padding: 0; margin: 0; }
  .dist-list li { display: flex; flex-direction: column; gap: 4px; overflow-x: auto; }
  .dist-link { font-weight: 700; text-decoration: none; }
</style>
